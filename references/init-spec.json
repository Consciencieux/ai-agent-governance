{
  "$schema": "init-spec-v1",
  "description": "Machine-readable specification for the INIT scripted generator. SKILL.md references this file; never restate its contents in prose. Single source of truth for what the generator produces.",
  "invariants": {
    "copied_scripts_are_self_contained": "Artifacts of type 'copy' under scripts/ are copied into governed projects FILE BY FILE. Self-contained means the INSTALLED dependency graph closes: Node builtins are always allowed; a relative require is allowed only when it resolves to another artifact source listed here (and thus actually copied by INIT). Forbidden: require of undeclared siblings, skill-repo-only files, or undeclared external runtime packages. A shared helper that is not listed as a copy source breaks every governed project (historical defect: scripts/_lib.js). Enforced by the 'payload:' tests in tests/suites/payload.test.js (static require-graph closure + INIT write check + end-to-end module resolution).",
    "distribution_roles_are_declared_not_inferred": "Every file under references/ and scripts/ has exactly one distribution role. INSTALLED = it appears as an artifact 'source' below (INIT writes it into the governed project). SKILL-INTERNAL = it is listed in distribution.skillInternal (it travels in the tarball because packaging copies references/ and scripts/ wholesale, but INIT never installs it, so a governed project does NOT have it). Roles are HUMAN decisions and must never be inferred from directory or filename: copy/template/generated, renames (lifecycle.policy.md -> docs/rules/lifecycle.md, verify_governance.js -> verify-governance.js), one-to-many outputs (githooks-template.md -> pre-commit + commit-msg) and static inline content all encode contract decisions a generator cannot recover. Enforced by repo-tools/check-role-completeness.js: no unclassified file, no file in both sets, no declared path that does not exist, and the tarball's file set must match the union of both roles."
  },
  "distribution": {
    "skillInternal": [
      "references/init-spec.json",
      "references/workflows/release.md",
      "scripts/generate-governance.js",
      "scripts/lib/generate/run.js",
      "references/principles/entry.md",
      "references/principles/instruction-architecture.md",
      "references/principles/document-model.md",
      "references/principles/metadata-policy.md",
      "references/principles/capability-model.md",
      "references/principles/control-shape.md",
      "references/principles/enforcement-semantics.md",
      "references/principles/decision-records.md",
      "references/principles/migration-method.md"
    ],
    "undecided": {}
  },
  "phases": {
    "A": {
      "name": "static skeleton",
      "description": "Rules, AGENTS.md, CHANGELOG, README bootstrap, feature placeholder strategy, plans skeleton, ARCHITECTURE skeleton",
      "shipped": "v0.9.0"
    },
    "B": {
      "name": "config, state and scripts",
      "description": "Config files (.gitignore,.env.example,.gitmessage), CI workflow selected by stack/platform,.governance/ state files, scripts copies. Sub-skills generation is Phase C.",
      "shipped": "v0.9.0"
    },
    "C": {
      "name": "structure-adaptive",
      "description": "Advisory scripts (freshness/consistency), sub-skills generation, existing doc root detection, merge-not-overwrite for existing content, parity with all 13 Phase-1 steps (CI selection, CLAUDE.md, README language layout)",
      "shipped": "v0.9.1"
    }
  },
  "inputs": {
    "target": {
      "type": "string",
      "required": true,
      "description": "Target project root (CLI: --target)"
    },
    "project_name": {
      "type": "string",
      "required": true,
      "description": "Project name for AGENTS.md heading and README"
    },
    "description": {
      "type": "string",
      "default": "",
      "description": "One-sentence project description (AGENTS.md Project Overview, ARCHITECTURE Overview)"
    },
    "maturity": {
      "type": "enum",
      "values": [
        "LEVEL_0_EMPTY",
        "LEVEL_1_PROTOTYPE",
        "LEVEL_2_ACTIVE",
        "LEVEL_3_PRODUCTION"
      ],
      "default": "LEVEL_0_EMPTY",
      "description": "Maturity level (written to state.json; structure-adaptive behavior is Phase C)"
    },
    "doc_root": {
      "type": "string",
      "default": "docs",
      "description": "Documentation root directory"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Primary documentation language (Phase C uses it for README layout)"
    },
    "test_cmd": {
      "type": "string",
      "default": "npm test",
      "description": "Test command for AGENTS.md"
    },
    "lint_cmd": {
      "type": "string",
      "default": "npm run lint",
      "description": "Lint command for AGENTS.md"
    },
    "build_cmd": {
      "type": "string",
      "default": "npm run build",
      "description": "Build command for AGENTS.md"
    },
    "governance_cmd": {
      "type": "string",
      "default": "npm run governance-check",
      "description": "Governance check command for AGENTS.md"
    },
    "convention": {
      "type": "string",
      "default": "Conventional Commits",
      "description": "Commit message convention for AGENTS.md"
    },
    "governance_version": {
      "type": "string",
      "default": "2.1.1",
      "description": "Governance framework version stamped into manifest/CHANGELOG"
    },
    "release_version": {
      "type": "string",
      "optional": true,
      "description": "If provided, manifest gains a release object (version/tag/validated). Omitted for fresh INIT - a new project has not released anything."
    },
    "stack": {
      "type": "enum",
      "values": [
        "node",
        "python",
        "rust",
        "go",
        "java",
        "cpp",
        "docs-only"
      ],
      "default": "docs-only",
      "description": "Detected primary stack; selects the CI template from references/workflows/ci.md"
    },
    "ci_platform": {
      "type": "enum",
      "values": [
        "github",
        "gitlab",
        "none"
      ],
      "default": "github",
      "description": "Detected CI platform; github ->.github/workflows/ci.yml, gitlab ->.gitlab-ci.yml, none -> skipped"
    }
  },
