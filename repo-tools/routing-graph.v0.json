      "discovery-ledger",
      "review-implementation",
      "security-baseline",
      "rule-capture"
    ],
    "test_change": [
      "change-hygiene",
      "testing-evidence"
    ],
    "unknown": [],
    "system_review": [
      "review-system"
    ],
    "research_review": [
      "review-research"
    ],
    "edit_changelog": [
      "change-hygiene",
      "changelog-policy",
      "discovery-ledger"
    ]
  },
  "binds": {
    "secret-protection": [
      "CTRL-0001",
      "scripts/check-secrets.js"
    ],
    "plan-delivery": [
      "repo-tools/check-plan-delivery.js"
    ]
  },
  "notes_routing_surface": [
    "FINDING-0038: authorities.path is READ surface only (md/policy/docs) — never .js.",
    "Mechanical carriers belong in binds → run_set (CTRL id and/or script path).",
    "Capability markdown may still describe Invoke; routing must not pretend reading a script is loading a rule."
  ],
  "facet_adds": [
    {
      "when": {
        "trees_includes": "references"
      },
      "add": [
        "reference-closure"
      ]
    },
    {
      "when": {
        "trees_any": [
          "scripts",
          "repo-tools"
        ]
      },
      "add": [
        "testing-evidence",
        "secret-protection"
      ]
    },
    {
      "when": {
        "write_boundary_in": [
          "commit",
          "tag",
          "release"
        ]
      },
      "add": [
        "git-write",
        "secret-protection"
      ]
    },
    {
      "when": {
        "write_boundary": "release"
      },
      "add": [
        "release-governance"
      ]
    },
    {
      "when": {
        "artifacts_includes": "plan",
        "scale": "large"
      },
      "add": [
        "discovery-ledger",
        "plan-delivery"
      ]
    },
    {
      "when": {
        "phase": "validate"
      },
      "add": [
        "testing-evidence"
      ]
    }
  ],
  "authorities": {
